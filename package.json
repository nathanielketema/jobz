        "@sveltejs/kit": "^2.69.3",
        "@sveltejs/vite-plugin-svelte": "^7.2.0",
        "@types/node": "^26.1.1",
        "drizzle-kit": "1.0.0-rc.4",
        "svelte": "^5.56.4",
        "svelte-check": "^4.7.3",
        "typescript": "^7.0.2",
        "vite": "^8.1.4"
    },
    "dependencies": {
        "drizzle-orm": "1.0.0-rc.4",
        "zod": "^4.4.3"
